# Mischief Made Analytics - Local Docker Airflow Environment
#
# Copy this file to .env for local development:
#
#   cp .env.example .env
#
# Then adjust local-only values in .env as needed.
#
# Do not commit .env, keys/, logs/, or local_data/.

# Airflow
AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=mischief-made-airflow:local
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__CORE__AUTH_MANAGER=airflow.providers.fab.auth_manager.fab_auth_manager.FabAuthManager
AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://airflow-apiserver:8080/execution/
AIRFLOW__API_AUTH__JWT_SECRET=replace-me-with-a-local-random-string

# Local Airflow admin user
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_FIRSTNAME=Drew
AIRFLOW_ADMIN_LASTNAME=User
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Postgres metadata DB for local Airflow
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres/airflow

# GCP / BigQuery
GCP_PROJECT_ID=mischief-made-analytics
GOOGLE_APPLICATION_CREDENTIALS=/opt/airflow/keys/gcp-sa.json
BIGQUERY_LOCATION=US

# Airflow connection used by the DAGs
AIRFLOW_CONN_GOOGLE_CLOUD_DEFAULT={"conn_type":"google_cloud_platform","extra":{"project":"mischief-made-analytics","key_path":"/opt/airflow/keys/gcp-sa.json"}}

# Shopify Admin API
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_API_VERSION=2026-04
SHOPIFY_API_CLIENT_ID=replace-me
SHOPIFY_API_CLIENT_SECRET=replace-me